{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window runtime",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-spawn-pty",
    "allow-resize-pty",
    "allow-write-to-pty",
    "allow-load-file-content",
    "allow-save-file-content",
    "allow-get-workspace-files"
  ]
}
